{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin the firmware fork commit the userspace builds against",
      "managerFilePatterns": ["/^firmware-fork-ref$/"],
      "matchStrings": ["(?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "master",
      "depNameTemplate": "anokfireball/qmk_firmware",
      "packageNameTemplate": "https://github.com/anokfireball/qmk_firmware",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "The qmk_cli image carries no org.opencontainers.image.source label, so point Renovate at the repo for release notes on version bumps",
      "matchPackageNames": ["ghcr.io/qmk/qmk_cli"],
      "sourceUrl": "https://github.com/qmk/qmk_cli"
    },
    {
      "description": "Renovate cannot build a changelog for a branch-digest bump, so link the commit range from the Change column",
      "matchDepNames": ["anokfireball/qmk_firmware"],
      "prBodyDefinitions": {
        "Change": "[`{{{displayFrom}}}` → `{{{displayTo}}}`](https://github.com/anokfireball/qmk_firmware/compare/{{{currentDigest}}}...{{{newDigest}}})"
      }
    }
  ]
}
